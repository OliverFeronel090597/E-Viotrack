

QWidget#central {
    background-color: #fafafa;
}

QWidget#nav {
    background-color: #3acdfa;
}

QToolTip {
    background-color: #2c2f33;
    font-size: 15px;
}

QLabel#imagelabel {
    border: 1px solid #fafafa;
}

QTextEdit#qoute {
    background-color: #f53030;
    color: #2c2f33;
}

/* =========================
   AdminPage Login Styles
   ========================= */

/* Labels */
QLabel#userlogin {
    font-size: 18px;
    color: #333333;
    font-weight: 500;
}

/* LineEdits */
QLineEdit#userlogin {
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 2px 4px;
    font-size: 18px;
    background-color: #ffffff;
    color: #222222;
}

QLineEdit#userlogin:focus {
    border: 1px solid #f53030;
    background-color: #ffffff;
}

/* Password input attached on left */
QLineEdit#passlogin {
    border: 1px solid #cccccc;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    padding: 2px 6px;
    font-size: 18px;
    background-color: #ffffff;
    color: #222222;
}

/* Focus style for input */
QLineEdit#passlogin:focus {
    border: 1px solid #f53030;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    background-color: #ffffff;
}

/* Show/Hide button attached on right */
QPushButton#showhide {
    border: 1px solid #cccccc;
    border-left: 0px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    background-color: #e1e1e1;
    padding: 4px 8px;
    font-size: 12px;
}

/* Hover effect */
QPushButton#showhide:hover {
    background-color: transparent;
    border: 1px solid #f53030;
}

/* Login button */
QPushButton#login {
    border-radius: 6px;
    background-color: #0078d7;
    color: #ffffff;
    font-weight: 600;
    font-size: 14px;
    padding: 8px 12px;
}

QPushButton#login:hover {
    background-color: #005a9e;
}

/* QTextEdit card (optional) */
QTextEdit#QuoteText {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #dddddd;
    padding: 10px;
    color: #222222;
    font-family: 'Segoe UI', Arial;
    font-size: 14px;
}

/* Optional: focus and selection */
QTextEdit#QuoteText:focus {
    border: 1px solid #0078d7;
}

/* QPushButton hover effects */
QPushButton#AddViolationBtn:hover {
    background-color: #2980b9;
}

QPushButton#DeleteViolationBtn:hover {
    background-color: #c0392b;
}

/* QLineEdit inputs */
QLineEdit#RFIDInput, QLineEdit#ViolationInput {
    font-size: 14px;
    padding: 6px;
    border: 1px solid #ccc;
    border-radius: 4px;
}

QLineEdit#RFIDInput:focus, QLineEdit#ViolationInput:focus {
    border: 1px solid #0078d7;
}

/* QTextEdit card */
QTextEdit#QuoteText {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #dddddd;
    padding: 10px;
    color: #222222;
    font-family: 'Segoe UI', Arial;
    font-size: 14px;
        selection-background-color: transparent;
    selection-color: inherit;
}


QTextEdit#QuoteText:focus {
    border: none;
    outline: none;
}

/* Header */
QHeaderView::section {
    background-color: #3498db;
    color: white;
    padding: 1px;
    border: 1px solid #2980b9;
    font-size: 13px;
}

/* QTreeView main area */
QTreeView#ViolationTree {
    background-color: #ffffff;
    color: #222222;
    font-size: 13px;
    border: 1px solid #ccc;
    border-radius: 6px;
    gridline-color: #e0e0e0;
}

/* Alternating row colors */
QTreeView#ViolationTree::item {
    padding: 1px 5px;
}

QTreeView#ViolationTree::item:alternate {
    background-color: #f4f5f7;
}

/* Selected row */
QTreeView#ViolationTree::item:selected {
    background-color: #2980b9;
    color: white;
    border: none;
}

QStatusBar#mainStatusBar {
    background: #f8f8f8;
    border-top: 1px solid #d0d0d0;
}

QLabel#statusUser {
    font-weight: bold;
    font-size: 14px;
    color: #666666;
}

QLabel#statusCenter {
    font-weight: 500;
    font-size: 14px;
    color: #666666;
}

QLabel#statusVersion {
    color: #666666;
    font-size: 13px;
}


/* =========================
   RFID Manager Styles
   ========================= */

QWidget#rfidManager {
    background-color: #fafafa;
}

QWidget#portContainer {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 6px;
}

QWidget#portRow {
    background-color: #f4f5f7;
    border-radius: 4px;
    padding: 4px;
}

QCheckBox#portCheckBox {
    font-size: 14px;
    color: #222222;
}

QComboBox#baudRateCombo {
    font-size: 14px;
    padding: 4px;
    border: 1px solid #cccccc;
    border-radius: 4px;
}

QComboBox#baudRateCombo:focus {
    border: 1px solid #0078d7;
}

QLabel#rfidReadLabel {
    font-size: 16px;
    font-weight: bold;
    color: #333333;
}

QListWidget#rfidTagList {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    font-size: 13px;
}
