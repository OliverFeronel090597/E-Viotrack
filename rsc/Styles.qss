/* ============================================================
   ROOT THEME TOKENS
   ============================================================ */
:root {
    --bg-main: #fafafa;
    --bg-light: #f4f5f7;
    --bg-card: #ffffff;
    --bg-accent: #3acdfa;
    --bg-danger: #f53030;

    --border-light: #cccccc;
    --border-dark: #2980b9;

    --text-main: #222222;
    --text-muted: #666666;
    --text-invert: #ffffff;

    --font-main: 'Segoe UI', Arial, sans-serif;
}

/* ============================================================
   GLOBAL
   ============================================================ */
QWidget#central { background-color: var(--bg-main); }
QWidget#nav     { background-color: var(--bg-accent); }

QToolTip {
    background-color: #2c2f33;
    color: white;
    font-size: 15px;
    padding: 4px 8px;
    border-radius: 4px;
}

QLabel#imagelabel { border: 1px solid var(--bg-main); }

QTextEdit#qoute {
    background-color: var(--bg-danger);
    color: #2c2f33;
}


/* ============================================================
   LOGIN PAGE
   ============================================================ */
QLabel#userlogin {
    font-size: 18px;
    color: #333;
    font-weight: 500;
}

QLabel#login_error {
    font-size: 15px;
    color: var(--bg-danger);
    font-weight: 500;
}

QLineEdit#userlogin,
QLineEdit#passlogin {
    border: 1px solid var(--border-light);
    background-color: var(--bg-card);
    color: var(--text-main);
    font-size: 18px;
    padding: 4px 6px;
}

/* Username Field */
QLineEdit#userlogin { border-radius: 6px; }
QLineEdit#userlogin:focus { border-color: var(--bg-danger); }

/* Password Field */
QLineEdit#passlogin {
    border-radius: 6px 0 0 6px;
}
QLineEdit#passlogin:focus {
    border-color: var(--bg-danger);
}

/* Show/Hide Password */
QPushButton#showhide {
    border: 1px solid var(--border-light);
    border-left: 0;
    border-radius: 0 6px 6px 0;
    background-color: #e1e1e1;
    padding: 4px 8px;
    font-size: 12px;
}
QPushButton#showhide:hover {
    border-color: var(--bg-danger);
    background-color: var(--bg-card);
}

/* Login Button */
QPushButton#login {
    background-color: #0078d7;
    color: var(--text-invert);
    font-weight: 600;
    font-size: 14px;
    padding: 8px 12px;
    border-radius: 6px;
}
QPushButton#login:hover {
    background-color: #005a9e;
}


/* ============================================================
   QUOTE CARD
   ============================================================ */
QTextEdit#QuoteText {
    background-color: var(--bg-card);
    border-radius: 12px;
    border: 1px solid #ddd;
    padding: 10px;
    color: var(--text-main);
    font-family: var(--font-main);
    font-size: 14px;

    selection-background-color: transparent;
    selection-color: inherit;
}

QTextEdit#QuoteText:focus {
    border: 1px solid var(--border-dark);
}


/* ============================================================
   COMMON BUTTONS
   ============================================================ */
QPushButton#AddViolationBtn:hover {
    background-color: #2980b9;
}

QPushButton#DeleteViolationBtn:hover {
    background-color: #c0392b;
}


/* ============================================================
   INPUTS (General)
   ============================================================ */
QLineEdit#RFIDInput,
QLineEdit#ViolationInput,
QLineEdit#maxLineEdit {
    font-size: 14px;
    padding: 6px;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    color: var(--text-main);
    background-color: var(--bg-card);
}

QLineEdit#RFIDInput:focus,
QLineEdit#ViolationInput:focus,
QLineEdit#maxLineEdit:focus {
    border-color: #0078d7;
}

QLabel#maxLineLabel {
    font-size: 14px;
    padding: 4px 6px;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    background-color: var(--bg-card);
    color: var(--text-main);
}


/* ============================================================
   TABLES / TREE VIEW
   ============================================================ */
QHeaderView::section {
    background-color: #3498db;
    color: white;
    padding: 3px;
    border: 1px solid #2980b9;
    font-size: 13px;
}

QTreeView#ViolationTree {
    background-color: var(--bg-card);
    color: var(--text-main);
    font-size: 13px;
    border: 1px solid var(--border-light);
    border-radius: 6px;
    gridline-color: #e0e0e0;
}

QTreeView#ViolationTree::item {
    padding: 2px 6px;
}

QTreeView#ViolationTree::item:alternate {
    background-color: var(--bg-light);
}

QTreeView#ViolationTree::item:selected {
    background-color: #2980b9;
    color: white;
    border: none;
}


/* ============================================================
   RFID MANAGER
   ============================================================ */
QWidget#rfidManager { background-color: var(--bg-main); }

QWidget#portContainer {
    background-color: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    padding: 6px;
}

QWidget#portRow {
    background-color: var(--bg-light);
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 4px;
}

QCheckBox#portCheckBox {
    font-size: 14px;
    color: var(--text-main);
    padding: 2px;
}


/* ============================================================
   COMBOBOX
   ============================================================ */
QComboBox#baudRateCombo {
    font-size: 14px;
    padding: 2px 4px;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    background-color: var(--bg-card);
    color: var(--text-main);
}

QComboBox#baudRateCombo:focus {
    border-color: #0078d7;
}

QComboBox#baudRateCombo QAbstractItemView {
    background-color: var(--bg-card);
    selection-background-color: var(--bg-accent);
    selection-color: var(--text-invert);
    color: var(--text-main);
}


/* ============================================================
   STATUS BAR
   ============================================================ */
QStatusBar#mainStatusBar {
    background: #f8f8f8;
    border-top: 1px solid #d0d0d0;
}

QLabel#statusUser,
QLabel#statusCenter,
QLabel#statusVersion {
    font-size: 14px;
    color: var(--text-muted);
}

QLabel#statusVersion {
    font-size: 13px;
}


/* ============================================================
   QListWidget Scrollbar (Shared)
   ============================================================ */
QListWidget#rfidTagList {
    background-color: var(--bg-light);
    border: 1px solid var(--border-dark);
    border-radius: 6px;
    font-size: 13px;
    color: var(--text-main);
}


/* SHARED SCROLLBAR STYLE */
QScrollBar:vertical,
QScrollBar:horizontal {
    background: var(--bg-card);
    border: 1px solid var(--border-dark);
    border-radius: 6px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: var(--bg-accent);
    min-height: 20px;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #2980b9;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background-color: #3acdfa;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::up-arrow,
QScrollBar::down-arrow,
QScrollBar::left-arrow,
QScrollBar::right-arrow {
    background: none;
    height: 0px;
    width: 0px;
}

QScrollBar::sub-page,
QScrollBar::add-page {
    background: transparent;
}


/* ============================================================
   LOG WINDOW
   ============================================================ */
QWidget#LogWindow {
    background-color: var(--bg-light);
}

QPlainTextEdit#LogView {
    background-color: var(--bg-card);
    border: 1px solid var(--border-dark);
    border-radius: 6px;
    font-size: 13px;
    color: var(--text-main);
    padding: 6px;
}
